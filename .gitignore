# Local environments and generated Python files
**/virtual_env/
**/.venv/
**/__pycache__/
*.py[cod]

# Local-only source material, backups, and oversized historical artifacts
/local-only/

# KiCad temporary state and automatic backups
**/*.kicad_prl
**/fp-info-cache
**/*-backups/

# Training outputs (the serving model in machine-learning/models is intentional)
/machine-learning/training/*.pkl
/machine-learning/training/*.joblib
/machine-learning/models/knn_scaler_best.pkl
